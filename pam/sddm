#%PAM-1.0

# Login screen: type your password, or press Enter on an empty box to scan
# your face (Howdy). Same password-first block as polkit-1; system-login's
# pam_shells/pam_nologin checks are kept in front of it.
auth       required                    pam_shells.so
auth       requisite                   pam_nologin.so
auth       required                    pam_faillock.so preauth silent deny=10 unlock_time=120
auth       [success=2 default=ignore]  pam_unix.so          try_first_pass nullok
auth       [success=1 default=ignore]  pam_howdy.so
auth       [default=die]               pam_faillock.so authfail deny=10 unlock_time=120
auth       optional                    pam_permit.so
auth       required                    pam_env.so
auth       required                    pam_faillock.so      authsucc deny=10 unlock_time=120
-auth      optional                    pam_gnome_keyring.so
-auth      optional                    pam_kwallet5.so

account    include                     system-login

password   include                     system-login

session    optional                    pam_keyinit.so       force revoke
session    include                     system-login
-session   optional                    pam_gnome_keyring.so auto_start
-session   optional                    pam_kwallet5.so      auto_start
