+  // Typing starts one scan; after a failure it only retries on an explicit
+  // empty Enter (force) or once the field has been cleared (see enteredPassword).
+  function startFace(force) {
+    if (!lockRequested || !sessionLock.secure || !facePamConfigured) return
+    if (facePam.active || faceStatus === "scanning") return
+    if (faceStatus === "failed" && !force) return
+
+    faceStatus = "scanning"
+    if (!facePam.start()) faceStatus = "failed"
+  }
+
+  function handleFaceFinished(result) {
+    if (!lockRequested) return
+    if (result === PamResult.Success) {
+      faceStatus = ""
+      finishUnlock()
+    } else {
+      faceStatus = "failed"
+    }
+  }
